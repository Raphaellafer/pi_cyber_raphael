bled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"nike-front.assisted-sale-new-checkout\",\"enabled\":true,\"variant\":{\"name\":\"sellerId\",\"payload\":{\"type\":\"string\",\"value\":\"2109,2105,2108,2104,2107,2110,2101,2094,0067,0069,0066,0064,0063,0062,0055,0058,0054,0056,0060,0057,0059,0050,0053,0052,0051,0049,0047,0046,0044,0037,0036,0035,0029,0028,0026,0024,0023,0022,0021,0020,0014,0013,0012,0009,0008,0007,0005\"},\"enabled\":true},\"impressionData\":false},{\"name\":\"nike-tetris-orange-ricky-consumer-status\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"tesseract-validate-variant-weight\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"marketplace-in.validate-order-transition\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"marketplacein-webapi.moderation-get-moderations-by-id\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"marketplace-in.get-seller-sku\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"bifrost-nike.ft-web-enable-pdp-tesseract\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"search-integrator-campaign\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"portal-seller-front.centauro-envios-tracking\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"marketplace-in.moderation.catalog.lock-last-model\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"tetris-teewee-campaign-consumer-status\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"nike-tetris-hero-allow-policies\",\"enabled\":true,\"variant\":{\"name\":\"default\",\"payload\":{\"type\":\"string\",\"value\":\"[\\\"261612\\\"]\"},\"enabled\":true},\"impressionData\":false},{\"name\":\"payment-api.ft-pix-bank\",\"enabled\":true,\"variant\":{\"name\":\"bank-distribution-percentage\",\"payload\":{\"type\":\"json\",\"value\":\"{\\\"ITAU\\\":100,\\\"BANCODOBRASIL\\\":0,\\\"BRADESCO\\\":0}\"},\"enabled\":true},\"impressionData\":false},{\"name\":\"bifrost-nike-customer-request-description\",\"enabled\":true,\"variant\":{\"name\":\"default\",\"payload\":{\"type\":\"json\",\"value\":\"{\\n   \\\"successOptions\\\":{\\n      \\\"new_delivery_date\\\":{\\n         \\\"title\\\":\\\"Nova previsão solicitada\\\",\\n         \\\"description\\\":\\\"Sua nova previsão foi solicitada, agora é só aguardar a nova data de entrega.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      },\\n      \\\"pix\\\":{\\n         \\\"title\\\":\\\"Solicitar restituição do valor\\\",\\n         \\\"description\\\":\\\"Sua restituição foi solicitada! A confirmação do cancelamento do pedido será enviada por e-mail, e o valor será devolvido via PIX na conta de origem do pagamento do pedido em até 48 horas úteis.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      },\\n      \\\"credit_reversal\\\":{\\n         \\\"title\\\":\\\"Solicitar restituição do valor\\\",\\n         \\\"description\\\":\\\"O cancelamento do pedido foi encaminhado. Após a confirmação, que será enviada por e-mail, aguarde a administradora do cartão realizar o estorno na próxima fatura. Se a fatura já estiver fechada, o valor será disponibilizado na seguinte. Se surgir alguma dúvida, entre em contato com a administradora do seu cartão, que poderá te ajudar com mais detalhes.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      },\\n      \\\"restitution\\\":{\\n         \\\"title\\\":\\\"Solicitar restituição do valor\\\",\\n         \\\"description\\\":\\\"Sua solicitação de restituição foi registrada! A confirmação do cancelamento do pedido será enviada por e-mail, e o reembolso será processado conforme a forma de pagamento utilizada. Se não receber a confirmação, verifique também a sua caixa de spam.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      },\\n      \\\"exchange_voucher\\\":{\\n         \\\"title\\\":\\\"Receber um vale-troca\\\",\\n         \\\"description\\\":\\\"O cancelamento do seu pedido foi encaminhado, e a criação do vale-troca será feita e estará disponível para uso em até 48 horas úteis após a confirmação do cancelamento, que será enviada por e-mail.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      }\\n   },\\n   \\\"requestOptions\\\":{\\n      \\\"unavailableOptions\\\":[\\n         {\\n            \\\"type\\\":\\\"has_delayed_request\\\",\\n            \\\"description\\\":\\\"Já recebemos a sua solicitação relacionada ao pedido em atraso. Em breve, você receberá novas informações via e-mail.\\\"\\n         }\\n      ],\\n      \\\"availableOptions\\\":[\\n         {\\n            \\\"type\\\":\\\"new_delivery_date\\\",\\n            \\\"title\\\":\\\"Solicitar nova previsão de entrega\\\",\\n            \\\"description\\\":\\\"Vamos entrar em contato com a transportadora e te informar o novo prazo de entrega.\\\"\\n         },\\n         {\\n            \\\"type\\\":\\\"cancel_order\\\",\\n            \\\"title\\\":\\\"Cancelar pedido\\\",\\n 