nData\":false},{\"name\":\"bifrost-centauro-customer-request-description\",\"enabled\":true,\"variant\":{\"name\":\"default\",\"payload\":{\"type\":\"json\",\"value\":\"{\\n   \\\"successOptions\\\":{\\n      \\\"new_delivery_date\\\":{\\n         \\\"title\\\":\\\"Nova previsão solicitada\\\",\\n         \\\"description\\\":\\\"Sua nova previsão foi solicitada, agora é só aguardar a nova data de entrega.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      },\\n      \\\"pix\\\":{\\n         \\\"title\\\":\\\"Solicitar restituição do valor\\\",\\n         \\\"description\\\":\\\"Sua restituição foi solicitada! A confirmação do cancelamento do pedido será enviada por e-mail, e o valor será devolvido via PIX na conta de origem do pagamento do pedido em até 48 horas úteis.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      },\\n      \\\"credit_reversal\\\":{\\n         \\\"title\\\":\\\"Solicitar restituição do valor\\\",\\n         \\\"description\\\":\\\"O cancelamento do pedido foi encaminhado. Após a confirmação, que será enviada por e-mail, aguarde a administradora do cartão realizar o estorno na próxima fatura. Se a fatura já estiver fechada, o valor será disponibilizado na seguinte. Se surgir alguma dúvida, entre em contato com a administradora do seu cartão, que poderá te ajudar com mais detalhes.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      },\\n      \\\"restitution\\\":{\\n         \\\"title\\\":\\\"Solicitar restituição do valor\\\",\\n         \\\"description\\\":\\\"Sua solicitação de restituição foi registrada! A confirmação do cancelamento do pedido será enviada por e-mail, e o reembolso será processado conforme a forma de pagamento utilizada. Se não receber a confirmação, verifique também a sua caixa de spam.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      },\\n      \\\"exchange_voucher\\\":{\\n         \\\"title\\\":\\\"Receber um vale-troca\\\",\\n         \\\"description\\\":\\\"O cancelamento do seu pedido foi encaminhado, e a criação do vale-troca será feita e estará disponível para uso em até 48 horas úteis após a confirmação do cancelamento, que será enviada por e-mail.\\\",\\n         \\\"disclaimer\\\":\\\"Importante: A entrega pode ocorrer durante essa solicitação. Nesse caso, o cancelamento da solicitação não é necessário.\\\"\\n      }\\n   },\\n   \\\"requestOptions\\\":{\\n      \\\"unavailableOptions\\\":[\\n         {\\n            \\\"type\\\":\\\"has_delayed_request\\\",\\n            \\\"description\\\":\\\"Já recebemos a sua solicitação relacionada ao pedido em atraso. Em breve, você receberá novas informações via e-mail.\\\"\\n         }\\n      ],\\n      \\\"availableOptions\\\":[\\n         {\\n            \\\"type\\\":\\\"new_delivery_date\\\",\\n            \\\"title\\\":\\\"Solicitar nova previsão de entrega\\\",\\n            \\\"description\\\":\\\"Vamos entrar em contato com a transportadora e te informar o novo prazo de entrega.\\\"\\n         },\\n         {\\n            \\\"type\\\":\\\"cancel_order\\\",\\n            \\\"title\\\":\\\"Cancelar pedido\\\",\\n            \\\"description\\\":\\\"Caso prefira cancelar o pedido e receber um vale troca ou o reembolso.\\\",\\n            \\\"restitutionOptions\\\":[\\n               {\\n                  \\\"type\\\":\\\"exchange_voucher\\\",\\n                  \\\"title\\\":\\\"Vale-troca\\\",\\n                  \\\"description\\\":\\\"Receba o valor em até 48 horas após a confirmação de cancelamento do pedido.\\\"\\n               },\\n               {\\n                  \\\"type\\\":\\\"restitution\\\",\\n                  \\\"title\\\":\\\"Restituição do valor\\\",\\n                  \\\"description\\\":\\\"Receba o valor em sua conta de origem. Esse processo pode demorar dependendo do método de pagamento utilizado na compra.\\\"\\n               }\\n            ]\\n         }\\n      ]\\n   }\\n}\"},\"enabled\":true},\"impressionData\":false},{\"name\":\"guardians-galaxy-wishlist-variants\",\"enabled\":true,\"variant\":{\"name\":\"modelcolors\",\"payload\":{\"type\":\"json\",\"value\":\"{\\\"modelColorIds\\\": [\\\"99583651\\\", \\\"M14YCWH3\\\", \\\"9887093I\\\"]}\"},\"enabled\":true},\"impressionData\":false},{\"name\":\"search-integrator-store\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"nike-power-reviews-v2-consumer_FLAG\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"bifrost-centauro.ft-app-cashback-info-pdp\",\"enabled\":true,\"variant\":{\"name\":\"cashbackInfoValueMock\",\"payload\":{\"type\":\"json\",\"value\":\"{\\n  \\\"percentage\\\": 15,\\n  \\\"percentageFormatted\\\": \\\"15%\\\"\\n}\"},\"enabled\":true},\"impressionData\":false},{\"name\":\"tesseract-model-buybox-new-sorter-for-all\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"omni.LinxStoreSynch\",\"enabled\":true,\"variant\":{\"name\":\"disabled\",\"enabled\":false},\"impressionData\":false},{\"name\":\"bifrost-centauro-ab-camisas\",\"enabled\":true,\"variant\":{\"name\":\"data\",\"payload\":{\"type\":\"string\",\"value\":\"{\\\"Triggers\\\":[{\\\"themeId\\\":\\\"\\\",\\\"teamId\\\":\\\"0\\\",\\\"rules\\\":{\\\"rp\\\":{\\\"esportes\\\":[\\\"futebol\\\"],\\\"produto\\\":[\\\"camisadetime\\\",\\\"camisetadetime\\\",\\\"camisatimeselecao\\\",\\\"camisadetimenacional\\\",\\\"camisatimeinternacional\\\",\\\"campolonaclic\\\",\\\"campolointlic\\\",\\