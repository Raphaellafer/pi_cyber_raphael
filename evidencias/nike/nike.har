            "text": "{\"data\":[{\"id\":3,\"attributes\":{\"title\":\"Greve dos Correios\",\"description\":\"Devido à greve dos Correios, seu pedido pode sofrer um pequeno atraso. Estamos acompanhando a situação e trabalhando para minimizar possíveis impactos na entrega.\",\"position\":\"bottom-center\",\"link\":null,\"type\":\"warning\",\"dismissAfterClose\":false,\"createdAt\":\"2026-09-15T13:44:59.139Z\",\"updatedAt\":\"2026-09-15T13:48:10.633Z\",\"publishedAt\":\"2026-09-15T13:47:38.262Z\",\"media\":{\"data\":null},\"page\":[{\"id\":4,\"urlPath\":\"/meus-pedidos\",\"type\":\"includes\",\"urlParams\":null}]}}],\"meta\":{\"pagination\":{\"page\":1,\"pageSize\":25,\"pageCount\":1,\"total\":1}}}"
