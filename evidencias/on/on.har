deType\":3376},{},[6090],{\"data\":6091,\"content\":6092,\"nodeType\":3380},{},[6093],{\"data\":6094,\"marks\":6095,\"value\":6096,\"nodeType\":3384},{},[],\"Administre os pedidos e acompanhe as entregas diretamente em sua conta.\",{\"valueRichText\":6098},{\"json\":6099,\"__typename\":3413},{\"data\":6100,\"content\":6101,\"nodeType\":3376},{},[6102],{\"data\":6103,\"content\":6104,\"nodeType\":3380},{},[6105,6109,6117],{\"data\":6106,\"marks\":6107,\"value\":6108,\"nodeType\":3384},{},[],\"As devoluções e trocas estão disponíveis para produtos sem sinais de uso, dentro de {{returnEligibilityPeriod}} dias após a compra. Confira nossas \",{\"data\":6110,\"content\":6112,\"nodeType\":3389},{\"uri\":6111},\"https://www.on.com/faq\",[6113],{\"data\":6114,\"marks\":6115,\"value\":6116,\"nodeType\":3384},{},[],\"Perguntas Frequentes — FAQs\",{\"data\":6118,\"marks\":6119,\"value\":4160,\"nodeType\":3384},{},[],{\"valueRichText\":6121},{\"json\":6122,\"__typename\":3413},{\"data\":6123,\"content\":6124,\"nodeType\":3376},{},[6125],{\"data\":6126,\"content\":6127,\"nodeType\":3380},{},[6128],{\"data\":6129,\"marks\":6130,\"value\":6131,\"nodeType\":3384},{},[],\"Parece que você ainda não fez nenhum pedido com esta conta. Achamos que você vai amar essas peças.\",{\"valueRichText\":6133},{\"json\":6134,\"__typename\":3413},{\"data\":6135,\"content\":6136,\"nodeType\":3376},{},[6137],{\"data\":6138,\"content\":6139,\"nodeType\":3380},{},[6140],{\"data\":6141,\"marks\":6142,\"value\":6143,\"nodeType\":3384},{},[],\"Our return is a thank you to the planet and we want to show gratitude for your efforts. The return is on us, we will assess the quality of your Cyclon-T and send it off to be recycled or to be pre-loved gear.\",{\"valueRichText\":6145},{\"json\":6146,\"__typename\":3413},{\"nodeType\":3376,\"data\":6147,\"content\":6148},{},[6149],{\"nodeType\":3380,\"data\":6150,\"content\":6151},{},[6152],{\"nodeType\":3384,\"value\":6153,\"marks\":6154,\"data\":6155},\"The products below are not eligible for take back\",[],{},{\"valueRichText\":6157},{\"json\":6158,\"__typename\":3413},{\"data\":6159,\"content\":6160,\"nodeType\":3376},{},[6161,6169],{\"data\":6162,\"content\":6163,\"nodeType\":6168},{},[6164],{\"data\":6165,\"marks\":6166,\"value\":6167,\"nodeType\":3384},{},[],\"PARTE DA COLEÇÃO CYCLON™\",\"heading-2\",{\"data\":6170,\"content\":6171,\"nodeType\":3380},{},[6172,6176,6184],{\"data\":6173,\"marks\":6174,\"value\":6175,\"nodeType\":3384},{},[],\"\\nCyclon™ é o nosso programa de circularidade, com produtos premium feitos para serem reciclados. Disponível por assinatura. Para garantir que os materiais serão reciclados, criamos um plano de assinatura para nossos tênis Cyclon™. Perguntas frequentes - \",{\"data\":6177,\"content\":6179,\"nodeType\":3389},{\"uri\":6178},\"https://customer-service.on-running.com/pt-pt/cyclon\",[6180],{\"data\":6181,\"marks\":6182,\"value\":3578,\"nodeType\":3384},{},[6183],{\"type\":4829},{\"data\":6185,\"marks\":6186,\"value\":1972,\"nodeType\":3384},{},[],{\"valueRichText\":6188},{\"json\":6189,\"__typename\":3413},{\"nodeType\":3376,\"data\":6190,\"content\":6191},{},[6192,6199],{\"nodeType\":6193,\"data\":6194,\"content\":6195},\"heading-3\",{},[6196],{\"nodeType\":3384,\"value\":1269,\"marks\":6197,\"data\":6198},[],{},{\"nodeType\":3380,\"data\":6200,\"content\":6201},{},[6202],{\"nodeType\":3384,\"value\":6203,\"marks\":6204,\"data\":6205},\"\\nEste produto é exclusivo para quem é da Comunidade On. Para comprá-lo, você precisa entrar em sua conta (ou criar uma). Quando você entrar em sua conta, poderá adicioná-lo à sacola. Simples assim.\",[],{},{\"valueRichText\":6207},{\"json\":6208,\"__typename\":3413},{\"data\":6209,\"content\":6210,\"nodeType\":3376},{},[6211,6230],{\"data\":6212,\"content\":6213,\"nodeType\":3380},{},[6214,6218,6226],{\"data\":6215,\"marks\":6216,\"value\":6217,\"nodeType\":3384},{},[],\"Aguente aí! Enviamos um e-mail para \",{\"data\":6219,\"content\":6221,\"nodeType\":3389},{\"uri\":6220},\"/password/recover\",[6222],{\"data\":6223,\"marks\":6224,\"value\":6225,\"nodeType\":3384},{},[],\"{{email}}\",{\"data\":6227,\"marks\":6228,\"value\":6229,\"nodeType\":3384},{},[],\" com um link para reestabelecer sua senha.\",{\"data\":6231,\"content\":6232,\"nodeType\":3380},{},[6233],{\"data\":6234,\"marks\":6235,\"value\":6236,\"nodeType\":3384},{},[],\"Não recebeu? Verifique se seu endereço de e-mail está correto.\",{\"valueRichText\":6238},{\"json\":6239,\"__typename\":3413},{\"data\":6240,\"content\":6241,\"nodeType\":3376},{},[6242],{\"data\":6243,\"content\":6244,\"nodeType\":3380},{},[6245,6250],{\"data\":6246,\"marks\":6247,\"value\":6249,\"nodeType\":3384},{},[6248],{\"type\":4055},\"Não encontrou esses detalhes?\\n\",{\"data\":6251,\"marks\":6252,\"value\":6253,\"nodeType\":3384},{},[],\"Você pode fazer uma solicitação de garantia sem enviar essas informações, mas elas nos ajudam a processar sua solicitação mais rapidamente.\",{\"valueRichText\":6255},{\"json\":6256,\"__typename\":3413},{\"data\":6257,\"content\":6258,\"nodeType\":3376},{},[6259],{\"data\":6260,\"content\":6261,\"nodeType\":3380},{},[6262,6266,6274],{\"data\":6263,\"marks\":6264,\"value\":6265,\"nodeType\":3384},{},[],\"Acesse nossa \",{\"data\":6267,\"content\":6269,\"nodeType\":3389},{\"uri\":6268},\"/support\",[6270],{\"data\":6271,\"marks\":6272,\"value\":6273,\"nodeType\":3384},{},[],\"Central de Ajuda\",{\"data\":6275,\"marks\":6276,\"value\":6277,\"nodeType\":3384},{},[],\" para iniciar uma devolução ou solicitação de garantia.\",{\"valueRichText\":6279},{\"json\":6280,\"__typename\":3413},{\"data\":6281,\"content\":6282,\"nodeType\":3376},{},[6283],{\"data\":6284,\"content\":6285,\"nodeType\":3380},{},[6286,6290,6298],{\"data\":6287,\"marks\":6288,\"value\":6289,\"nodeType\":3384},{},[],\"Se você tem uma conta On, \",{\"data\":6291,\"content\":6293,\"nodeType\":3389},{\"uri\":6292},\"/order-tracker?navState=login\",[6294],{\"data\":6295,\"marks\":6296,\"value\":6297,\"nodeType\":3384},{},[],\"entre\",{\"data\":6299,\"marks\":6300,\"value\":6301,\"nodeType\":3384},{},[],\" e confira o estado do seu pedido na seção Pedidos.\\n\",{\"valueRichText\":6303},{\"json\":6304,\"__typename\":3413},{\"data\":6305,\"content\":6306,\"nodeType\":3376},{},[6307],{\"data\":6308,\"content\":6309,\"nodeType\":3380},{},[6310,6314,6322],{\"data\":6311,\"marks\":6312,\"value\":6313,\"nodeType\":3384},{},[],\"Confira o andamento do pedido na seção \",{\"data\":6315,\"content\":6317,\"nodeType\":3389},{\"uri\":6316},\"/account/orders\",[6318],{\"data\":6319,\"marks\":6320,\"value\":6321,\"nodeType\":3384},{},[],\"Seus Pedidos\",{\"data\":6323,\"marks\":6324,\"value\":6325,\"nodeType\":3384},{},[],\" da sua conta On.\",{\"valueRichText\":6327},{\"json\":6328,\"__typename\":3413},{\"data\":6329,\"content\":6330,\"nodeType\":3376},{},[6331],{\"data\":6332,\"content\":6333,\"nodeType\":3380},{},[6334],{\"data\":6335,\"marks\":6336,\"value\":6337,\"nodeType\":3384},{},[],\"Para iniciar uma devolução ou troca, acesse sua conta e clique na seção “Pedidos”. Você também pode fazer isso pelo nosso formulário de devolução / troca disponível na Central de Ajuda. Você só precisa do número do pedido e do endereço de e-mail, encontrados no e-mail de confirmação do seu pedido. \",{\"valueRichText\":6339},{\"json\":6340,\"__typename\":3413},{\"data\":6341,\"content\":6342,\"nodeType\":3376},{},[6343],{\"data\":6344,\"content\":6345,\"nodeType\":3380},{},[6346],{\"data\":6347,\"marks\":6348,\"value\":6349,\"nodeType\":3384},{},[],\"Os reembolsos serão emitidos após o recebimento do seu pedido. As reposições de trocas serão enviadas dentro de 7 a 14 dias úteis.\",{\"valueRichText\":6351},{\"json\":6352,\"__typename\":3413},{\"data\":6353,\"content\":6354,\"nodeType\":3376},{},[6355],{\"data\":6356,\"content\":6357,\"nodeType\":3380},{},[6358,6362,6370],{\"data\":6359,\"marks\":6360,\"value\":6361,\"nodeType\":3384},{},[],\"Se você tem conta na On, basta \",{\"data\":6363,\"content\":6365,\"nodeType\":3389},{\"uri\":6364},\"/returns?navState=login\",[6366],{\"data\":6367,\"marks\":6368,\"value\":6369,\"nodeType\":3384},{},[],\"entrar\",{\"data\":6371,\"marks\":6372,\"value\":6373,\"nodeType\":3384},{},[],\" nela e iniciar um processo de devolução na seção “Pedidos”.  \",{\"valueRichText\":6375},{\"json\":6376,\"__typename\":3413},{\"data\":6377,\"content\":6378,\"nodeType\":3376},{},[6379],{\"data\":6380,\"content\":6381,\"nodeType\":3380},{},[6382,6386,6392],{\"data\":6383,\"marks\":6384,\"value\":6385,\"nodeType\":3384},{},[],\"Para iniciar um processo de devolução, acesse a página “Minha conta” e clique na seção “\",{\"data\":6387,\"content\":6388,\"nodeType\":3389},{\"uri\":6316},[6389],{\"data\":6390,\"marks\":6391,\"value\":2833,\"nodeType\":3384},{},[],{\"data\":6393,\"marks\":6394,\"value\":6395,\"nodeType\":3384},{},[],\"”.\",{\"valueRichText\":6397},{\"json\":6398,\"__typename\":3413},{\"data\":6399,\"content\":6400,\"nodeType\":3376},{},[6401],{\"data\":6402,\"content\":6403,\"nodeType\":3380},{},[6404,6408,6417],{\"data\":6405,\"marks\":6406,\"value\":6407,\"nodeType\":3384},{},[],\"Consulte nossa página de \",{\"data\":6409,\"content\":6411,\"nodeType\":3389},{\"uri\":6410},\"/return-exchange-steps\",[6412],{\"data\":6413,\"marks\":6414,\"value\":6416,\"nodeType\":3384},{},[6415],{\"type\":4829},\"Processo de devolução por país\",{\"data\":6418,\"marks\":6419,\"value\":6420,\"nodeType\":3384},{},[],\" para obter mais informações sobre como fazer uma devolução. \",{\"valueRichText\":6422},{\"json\":6423,\"__typename\":3413},{\"data\":6424,\"content\":6425,\"nodeType\":3376},{},[6426],{\"data\":6427,\"content\":6428,\"nodeType\":3380},{},[6429,6433,6440],{\"data\":6430,\"marks\":6431,\"value\":6432,\"nodeType\":3384},{},[],\"Confira nossa página de \",{\"data\":6434,\"content\":6435,\"nodeType\":3389},{\"uri\":6410},[6436],{\"data\":6437,\"marks\":6438,\"value\":6416,\"nodeType\":3384},{},[6439],{\"type\":4