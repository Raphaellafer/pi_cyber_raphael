          "content": {
            "mimeType": "application/json",
            "size": 2599,
            "text": "{\"data\":{\"campaigns\":[{\"variation\":{},\"campaignIds\":{\"experienceName\":null,\"variationName\":null,\"variationId\":null,\"decisionId\":null,\"selectorName\":\"dynamic-modal\",\"__typename\":\"CampaignIds\"},\"__typename\":\"Campaign\"},{\"variation\":{},\"campaignIds\":{\"experienceName\":null,\"variationName\":null,\"variationId\":null,\"decisionId\":null,\"selectorName\":\"dynamic-modal-exit\",\"__typename\":\"CampaignIds\"},\"__typename\":\"Campaign\"},{\"variation\":{\"imageUrl\":\"https://images.ctfassets.net/hnk2vsx53n6l/5CftZ6Pc250jZqlFXDUCyD/e140340291305d5659b7e70f52505875/popup-running.jpg\",\"imageFormat\":\"portrait\",\"size\":\"large\",\"position\":\"bottomRight\",\"isExpandable\":\"false\",\"isDismissible\":\"true\",\"backdrop\":\"none\",\"theme\":\"dark\",\"contentIdentifier\":\"Don't miss a step\",\"headline\":{\"en\":\"Don't miss a step\",\"de\":\"Das willst du nicht verpassen\",\"fr\":\"N’en ratez pas une miette\",\"it\":\"Non perderti mai nulla\",\"es\":\"No te quedes atrás\",\"ja\":\"一足先に情報をお届け\",\"pt\":\"Fique sempre por dentro\",\"ko\":\"한 순간도 놓치지 마세요\"},\"text\":{\"en\":\"Be first to discover the latest news, product drops and more from On. Enjoy 10% off your first order when you spend R$650 or more. \",\"de\":\"Sei unter den Ersten, die von den aktuellsten News, Produktneuheiten und mehr bei On erfahren. Zusätzlich sicherst du dir 10 % auf deine erste Bestellung ab 110 €.\",\"fr\":\"Nouveaux drops, actualités et plus encore : recevez des nouvelles de On. Profitez de 10 % de remise dès 100€ d’achat.\",\"it\":\"Scopri in anteprima le ultime novità, i nuovi drop e altro ancora. E approfitta di uno sconto del 10% quando fai un ordine del valore minimo di 110€.\",\"es\":\"Entérate antes que nadie de todas nuestras novedades y lanzamientos y consigue un 10% de descuento en tu primera compra de más de 110 €.\",\"ja\":\"ニュースレターにご登録いただくと、快適な走りを支える新製品のお知らせやOnの最新情報がいち早く受け取れます。また、今なら$XXX以上のお買い物で初回注文が10％割引になるクーポンもプレゼントいたします。\",\"pt\":\"Descubra as últimas novidades e lançamentos da On, antes de todo mundo. Aproveite 10% de desconto no seu primeiro pedido de R$650 ou mais.\",\"ko\":\"지금 구독하고 On의 최신 뉴스, 신제품 출시 등 다양한 소식을 가장 먼저 만나보세요. $XXX 이상 구매 시, 첫 주문 10% 할인 혜택을 드립니다.\"},\"cta1\":{\"text\":{\"en\":\"\",\"de\":\"\",\"fr\":\"\",\"it\":\"\",\"es\":\"\",\"ja\":\"\",\"pt\":\"\",\"ko\":\"\"},\"link\":\"\",\"type\":\"text/html\"},\"cta2\":{\"text\":{\"en\":\"\",\"de\":\"\",\"fr\":\"\",\"it\":\"\",\"es\":\"\",\"ja\":\"\",\"pt\":\"\",\"ko\":\"\"},\"link\":\"\",\"type\":\"text/html\"},\"showNewsletterForm\":\"true\",\"newsletterSignupSubmitSuccessHeadline\":{\"en\":\"It's on. Thanks for signing up.\",\"de\":\"Los geht‘s. Danke für deine Anmeldung.\",\"fr\":\"C’est parti. Merci de votre inscription.\",\"it\":\"Fatto. Grazie per l’iscrizione.\",\"es\":\"Listo. Gracias por suscribirte.\",\"ja\":\"ありがとうございます。\",\"pt\":\"Está On. Obrigado por se cadastrar.\",\"ko\":\"신청이 완료되었습니다. 신청해 주셔서 감사합니다.\"},\"newsletterSignupSubmitSuccessText\":{\"en\":\"\",\"de\":\"\",\"fr\":\"\",\"it\":\"\",\"es\":\"\",\"ja\":\"\",\"pt\":\"\",\"ko\":\"\"},\"newsletterSignupSubmitSuccessCta\":{\"text\":{\"en\":\"\",\"de\":\"\",\"fr\":\"\",\"it\":\"\",\"es\":\"\",\"ja\":\"\",\"pt\":\"\",\"ko\":\"\"},\"link\":\"\",\"type\":\"text/html\"},\"recommendationCampaignSelectorName\":\"\",\"showNameInput\":\"false\",\"showGenderSelect\":\"false\",\"showSubscribeToNewsletterCheckbox\":\"false\",\"submitButtonText\":{\"en\":\"Sign up now\",\"de\":\"Benachrichtigung erhalten\",\"fr\":\"Me prévenir\",\"it\":\"Avvisami\",\"es\":\"Avísame\",\"ja\":\"送信する\",\"pt\":\"Me avise\",\"ko\":\"\"},\"sailthruListName\":\"Master_B2C\",\"source\":\"Website Overlay\",\"campaign\":\"Incentive_Capture_Test_DY_Variant_C\",\"initDelay\":2000,\"closeCookieName\":\"incentive-test\",\"scrollTrigger\":0,\"closeCookieLifetime\":5,\"showMode\":\"pageEnter\",\"suppressWunderkind\":\"true\",\"minimumPageViews\":1,\"isMembershipExclusive\":\"false\",\"imageAspectRatio\":\"1:1\",\"successContent\":\"newsletter-form-succes\",\"richText\":\"\"},\"campaignIds\":{\"experienceName\":\"Generic BR\",\"variationName\":\"Generic BR\",\"variationId\":30806958,\"decisionId\":\"nbMxODE2MzQzNzg0MDExNDQ4OTUwzgAlsH6oMTU2MzE3MTgBkJHOAdYTrqU5MzE2N8DZIGE4Y2Y2YjFiOGUyNDc2NDEwNGUwZmI1MzZkZDBjNzEztC0zOTc3MDI1NTcxOTIyNjMwOTA5wMDA\",\"selectorName\":\"dynamic-modal-amer\",\"__typename\":\"CampaignIds\"},\"__typename\":\"Campaign\"}]}}"
          },
