"marks\":5089,\"value\":5090,\"nodeType\":3384},{},[],\"\\nLimmatquai 28, 8001 Zurique, Suíça\",{\"data\":5092,\"content\":5093,\"nodeType\":3380},{},[5094,5099],{\"data\":5095,\"marks\":5096,\"value\":5098,\"nodeType\":3384},{},[5097],{\"type\":4055},\"On Madrid Serrano\",{\"data\":5100,\"marks\":5101,\"value\":5102,\"nodeType\":3384},{},[],\"\\nC. de Serrano, 17, 28001 Madri, Espanha\",{\"valueRichText\":5104},{\"json\":5105,\"__typename\":3413},{\"data\":5106,\"content\":5107,\"nodeType\":3376},{},[5108,5120,5132],{\"data\":5109,\"content\":5110,\"nodeType\":3380},{},[5111,5116],{\"data\":5112,\"marks\":5113,\"value\":5115,\"nodeType\":3384},{},[5114],{\"type\":4055},\"On Flagship Store Tokyo Ginza\\n\",{\"data\":5117,\"marks\":5118,\"value\":5119,\"nodeType\":3384},{},[],\"4-3-1 Ginza, Chuo-ku, Tokyo, Japão\",{\"data\":5121,\"content\":5122,\"nodeType\":3380},{},[5123,5128],{\"data\":5124,\"marks\":5125,\"value\":5127,\"nodeType\":3384},{},[5126],{\"type\":4055},\"On Seoul Hannam\",{\"data\":5129,\"marks\":5130,\"value\":5131,\"nodeType\":3384},{},[],\"\\n240 Itaewon-ro, Yongsan-gu, Seul, Coreia do Sul\",{\"data\":5133,\"content\":5134,\"nodeType\":3380},{},[5135,5140],{\"data\":5136,\"marks\":5137,\"value\":5139,\"nodeType\":3384},{},[5138],{\"type\":4055},\"On Melbourne Emporium\",{\"data\":5141,\"marks\":5142,\"value\":5143,\"nodeType\":3384},{},[],\"\\n287 Lonsdale Street, Melbourne, Austrália\",{\"valueRichText\":5145},{\"json\":5146,\"__typename\":3413},{\"nodeType\":3376,\"data\":5147,\"content\":5148},{},[5149],{\"nodeType\":3380,\"data\":5150,\"content\":5151},{},[5152],{\"nodeType\":3384,\"value\":5153,\"marks\":5154,\"data\":5155},\"O Cyclon™ está evoluindo.\\n\\nAgora, o programa terá como objetivo disponibilizar nossos produtos de revenda e trade-in para todo mundo, sem assinatura. Por isso, sua assinatura Cyclon™ será encerrada no dia 16 de abril.\\n\\nComo agradecimento por fazer parte da nossa jornada até agora, temos um presente para você (confira o seu e-mail).\",[],{},{\"valueRichText\":5157},{\"json\":5158,\"__typename\":3413},{\"nodeType\":3376,\"data\":5159,\"content\":5160},{},[5161],{\"nodeType\":3380,\"data\":5162,\"content\":5163},{},[5164],{\"nodeType\":3384,\"value\":5165,\"marks\":5166,\"data\":5167},\"Em 16 de abril, sua assinatura Cyclon™ será encerrada, e começaremos um novo capítulo focado em revendas e trade-in. Disponível para todo mundo. Nosso objetivo é tomar responsabilidade por todos os produtos que comercializamos, não apenas modelos específicos. Não vamos mais cobrar mensalidade, e você pode ficar com o seu tênis Cyclon™ atual até que decida devolver. Quando o recebermos de volta, ele será encaminhado para reciclagem. \\n\\nConvidamos você a nos acompanhar na jornada rumo a um futuro mais circular.\\n\\n*Disponível somente em algumas localidades.\",[],{},{\"valueRichText\":5169},{\"json\":5170,\"__typename\":3413},{\"data\":5171,\"content\":5172,\"nodeType\":3376},{},[5173],{\"data\":5174,\"content\":5175,\"nodeType\":3380},{},[5176,5180,5188],{\"data\":5177,\"marks\":5178,\"value\":5179,\"nodeType\":3384},{},[],\"O prazo de {{ eligibilityTimeSpanDays }} dias para devolução ou troca acabou. Para mais informações sobre nossa política de cancelamento, consulte os \",{\"data\":5181,\"content\":5183,\"nodeType\":3389},{\"uri\":5182},\"https://customer-service.on-running.com/terms_and_conditions\",[5184],{\"data\":5185,\"marks\":5186,\"value\":5187,\"nodeType\":3384},{},[],\"Termos & Condições da On\",{\"data\":5189,\"marks\":5190,\"value\":3449,\"nodeType\":3384},{},[],{\"valueRichText\":5192},{\"json\":5193,\"__typename\":3413},{\"data\":5194,\"content\":5195,\"nodeType\":3376},{},[5196],{\"data\":5197,\"content\":5198,\"nodeType\":3380},{},[5199,5203,5211],{\"data\":5200,\"marks\":5201,\"value\":5202,\"nodeType\":3384},{},[],\"Seu tamanho está fora de estoque? Fale com nossa \",{\"data\":5204,\"content\":5206,\"nodeType\":3389},{\"uri\":5205},\"https://www.on.com/contact-us\",[5207],{\"data\":5208,\"marks\":5209,\"value\":5210,\"nodeType\":3384},{},[],\"equipe de Happiness Delivery\",{\"data\":5212,\"marks\":5213,\"value\":5214,\"nodeType\":3384},{},[],\" para receber ajuda.\\nSe quiser outra opção, você também pode solicitar uma etiqueta de envio na página da assinatura para devolver seu tênis Cyclon™ sem uso.\",{\"valueRichText\":5216},{\"json\":5217,\"__typename\":3413},{\"data\":5218,\"content\":5219,\"nodeType\":3376},{},[5220],{\"data\":5221,\"content\":5222,\"nodeType\":3380},{},[5223,5227],{\"data\":5224,\"marks\":5225,\"value\":449,\"nodeType\":3384},{},[5226],{\"type\":4055},{\"data\":5228,\"marks\":5229,\"value\":5230,\"nodeType\":3384},{},[],\": Devolva seu tênis {{product}} para podermos manter os materiais sempre em movimento. Enviamos a etiqueta de devolução para o seu e-mail.\",{\"valueRichText\":5232},{\"json\":5233,\"__typename\":3413},{\"data\":5234,\"content\":5235,\"nodeType\":3376},{},[5236,5256],{\"data\":5237,\"content\":5238,\"nodeType\":3380},{},[5239,5244,5248,5253],{\"data\":5240,\"marks\":5241,\"value\":5243,\"nodeType\":3384},{},[5242],{\"type\":4055},\"Devolução:\",{\"data\":5245,\"marks\":5246,\"value\":5247,\"nodeType\":3384},{},[],\" Devolva seu tênis {{product}} até \",{\"data\":5249,\"marks\":5250,\"value\":5252,\"nodeType\":3384},{},[5251],{\"type\":4055},\"{{returnByDate}}\",{\"data\":5254,\"marks\":5255,\"value\":3449,\"nodeType\":3384},{},[],{\"data\":5257,\"content\":5258,\"nodeType\":3380},{},[5259,5263,5268],{\"data\":5260,\"marks\":5261,\"value\":5262,\"nodeType\":3384},{},[],\"Enviamos a etiqueta de devolução para o seu e-mail. Você tem \",{\"data\":5264,\"marks\":5265,\"value\":5267,\"nodeType\":3384},{},[5266],{\"type\":4055},\"{{days}} dias para devolver o par antigo\",{\"data\":5269,\"marks\":5270,\"value\":5271,\"nodeType\":3384},{},[],\". Caso contrário, cobraremos uma taxa de sustentabilidade.\",{\"valueRichText\":5273},{\"json\":5274,\"__typename\":3413},{\"data\":5275,\"content\":5276,\"nodeType\":3376},{},[5277],{\"data\":5278,\"content\":5279,\"nodeType\":3380},{},[5280],{\"data\":5281,\"marks\":5282,\"value\":5283,\"nodeType\":3384},{},[],\"Em manutenção. \\n\\nO programa Cyclon™ está mudando para melhor. Os recursos de gerenciamento da assinatura estão indisponíveis enquanto nos preparamos para a próxima fase. Volte em alguns dias. \\n\\nLamentamos o inconveniente.\",{\"valueRichText\":5285},{\"json\":5286,\"__typename\":3413},{\"data\":5287,\"content\":5288,\"nodeType\":3376},{},[5289],{\"data\":5290,\"content\":5291,\"nodeType\":3380},{},[5292,5296,5302],{\"data\":5293,\"marks\":5294,\"value\":5295,\"nodeType\":3384},{},[],\"Seu tamanho está fora de estoque?\\nEscolha outro modelo ou fale com nossa \",{\"data\":5297,\"content\":5298,\"nodeType\":3389},{\"uri\":5205},[5299],{\"data\":5300,\"marks\":5301,\"value\":5210,\"nodeType\":3384},{},[],{\"data\":5303,\"marks\":5304,\"value\":3449,\"nodeType\":3384},{},[],{\"valueRichText\":5306},{\"json\":5307,\"__typename\":3413},{\"data\":5308,\"content\":5309,\"nodeType\":3376},{},[5310],{\"data\":5311,\"content\":5312,\"nodeType\":3380},{},[5313,5317,5323],{\"data\":5314,\"marks\":5315,\"value\":5316,\"nodeType\":3384},{},[],\"Seu tamanho está fora de estoque?\\nFale com nossa \",{\"data\":5318,\"content\":5319,\"nodeType\":3389},{\"uri\":5205},[5320],{\"data\":5321,\"marks\":5322,\"value\":5210,\"nodeType\":3384},{},[],{\"data\":5324,\"marks\":5325,\"value\":5326,\"nodeType\":3384},{},[],\" para receber ajuda\",{\"valueRichText\":5328},{\"json\":5329,\"__typename\":3413},{\"data\":5330,\"content\":5331,\"nodeType\":3376},{},[5332],{\"data\":5333,\"content\":5334,\"nodeType\":3380},{},[5335,5339],{\"data\":5336,\"marks\":5337,\"value\":4937,\"nodeType\":3384},{},[5338],{\"type\":4055},{\"data\":5340,\"marks\":5341,\"value\":5342,\"nodeType\":3384},{},[],\" | Lançamento: 5 de março\\n1424 Abbot Kinney Blvd, Venice, CA 90291, USA\",{\"valueRichText\":5344},{\"json\":5345,\"__typename\":3413},{\"data\":5346