          "content": {
            "mimeType": "text/javascript",
            "size": 2175,
            "text": "//Onrunning\nvar br_data = {};\n(function LAPixel() {\n  if (window.location.href.includes('sandbox') && !window.location.href.includes('checkouts')) {\n    return;\n  }\n  if (!(window.location.href.includes('on.com') && window.location.href.includes('/en-us'))) {\n    return;\n  }\n\n  var br_acct_id = 8124;\n  let selector = 'script[src=\"' + `//cdn.brcdn.com/v1/br-trk-${br_data.acct_id}.js\"`;\n  let brTrk = document.querySelector(selector);\n  if (brTrk)\n    return;\n\n  let debug = false;\n  br_data.title = document.title;\n  br_data.ptype = 'other';\n  br_data.domain_key = 'demo_on_running'\n  br_data.currency = 'USD'\n\n  if (debug) {\n    br_data.debug = debug;\n    br_data.test_data = 'true';\n  }\n  br_data.acct_id = br_acct_id;\n\n  const dlPushHandler = {\n    apply: function (target, thisArg, args) {\n      try {\n        const event = args[0];\n\n        if (event.event === 'add_to_cart') {\n          event.ecommerce.items.forEach(e => {\n            logATCEvent(e.item_id.slice(0, -4), e.full_sku.replaceAll(/[^a-zA-Z0-9]/g, '_'))\n\n          })\n        } else {\n          const trackView = supplyPageData(args[0]);\n          if (trackView)\n            logPageView();\n        }\n      } catch (e) {\n        debug && console.debug(`Error tracking event:${args[0]}`);\n      }\n\n      return Reflect.apply(target, thisArg, args);\n    },\n  };\n\n  for (const event of dataLayer) {\n    const trackView = supplyPageData(event);\n    if (trackView) {\n      injectBrTrk();\n    }\n  }\n  window.dataLayer.push = new Proxy(window.dataLayer.push, dlPushHandler);\n\n  function logPageView() {\n    if (!window['BrTrk']) {\n      injectBrTrk();\n      return;\n    }\n    br_data.orig_ref_url = window.location.href;\n    BrTrk.getTracker().updateBrData(br_data);\n    BrTrk.getTracker().logPageView();\n  }\n\n  function logATCEvent(prod_id = '', sku = '') {\n    debug && console.debug('[BR] ATC Event Triggered', {\n      prod_id: prod_id,\n      sku: sku,\n    });\n    BrTrk.getTracker().logEvent('cart', 'click-add', {\n      prod_id: prod_id,\n      sku: sku,\n    });\n  }\n  function logQuickView(prod_id = '', sku = '', prod_name = '') {\n    debug && console.debug('[BR] Quick View Triggered', {\n      prod_id: prod_id,\n      sku: sku,\n      prod_name: prod_name\n    });\n    BrTrk.getTracker().logEvent('product', 'quickview', {\n      prod_id: prod_id,\n      sku: sku,\n      prod_name: prod_name\n    });\n  }\n  // function logSearchEvent(search_term = '') {\n  //   debug &&\n  //     console.debug('[BR] ATC Event Triggered', {\n  //       prod_id: prod_id,\n  //       sku: sku,\n  //     });\n  //   BrTrk.getTracker().logEvent('cart', 'click-add', {\n  //     prod_id: prod_id,\n  //     sku: sku,\n  //   });\n  // }\n\n  function elementObserver(event, ...args) {\n    const observer = new MutationObserver((mutations) => {\n      event(...args);\n    }\n    );\n\n    observer.observe(document, {\n      childList: true,\n      subtree: true,\n    });\n  }\n\n  async function delay(ms = 1000) {\n    await new Promise(function (resolve) {\n      setTimeout(function () {\n        resolve();\n      }, ms);\n    }\n    );\n  }\n\n  function getAttributeFromUrlQuery(query) {\n    try {\n      const queryParams = new URLSearchParams(window.location.search);\n      return queryParams.get(query);\n    } catch (e) {\n      debug && console.debug(`[BR] Error in getAttributeFromURLQuery(\"${query}}\"):`, '\\n', e);\n    }\n  }\n\n  function getPTypeFromUrl(pageIdentifier) {\n    return url.match(pageIdentifier) !== null;\n  }\n\n  function supplyPageData(event = {}) {\n    br_data.title = document.title;\n\n    const isPageView = event.event === 'gtm.load' || event.event === 'virtual_page_view'\n\n    if (false) { } else if (isPageView && window.location.pathname === '/en-us/') {\n      try {\n        br_data.ptype = 'homepage';\n        return true;\n      } catch (e) { }\n    } else if (event.event === 'view_item_list' && event.search_type === 'manual' && event.search_term) {\n      try {\n        br_data.ptype = 'search';\n        br_data.search_term = event.search_term ?? '';\n\n        try {\n\n          br_data.ranking = event.ecommerce.items.map(e => e.item_id.slice(0, -4)).join('|')\n\n        } catch (e) { }\n\n        return true;\n      } catch (e) {\n        debug && console.debug(`[BR] Search result page event supply function has thrown an error:`, '\\n', e);\n      }\n    } else if (event.event === 'view_item' && event.component === 'product_detail_page') {\n      try {\n\n        const productInfo = event.ecommerce.items[0]\n        br_data.ptype = 'product';\n        br_data.prod_id = productInfo.item_id.slice(0, -4);\n        br_data.sku = '';\n        const h1 = document.querySelector('h1[data-test-id=\"productNameTitle\"]');\n        const clone = h1.cloneNode(true);\n        clone.querySelectorAll('[class*=\"visuallyHidden\"]').forEach(el => el.remove());\n        const text = clone.textContent.trim();\n\n        br_data.prod_name = text\n\n        return true;\n      } catch (e) {\n        debug && console.debug(`[BR] Product page event supply functions have thrown an error:`, '\\n', e);\n      }\n    } else if (event.event === \"view_item_list\" && event.component === 'product_listing_page') {\n      br_data.ranking = undefined;\n      if (event.section?.includes('recommend')) {\n        return false\n      }\n      try {\n        const urlPart = window.location.pathname.replace('/en-us/shop/', '')\n\n        br_data.ptype = 'category';\n\n        br_data.cat_id = urlPart.replaceAll('/', '')\n        br_data.cat = urlPart.replaceAll('/', '|')\n\n        try {\n\n          br_data.ranking = event.ecommerce.items.map(e => e.item_id.slice(0, -4)).join('|')\n\n        } catch (e) { }\n\n        return true;\n      } catch (e) {\n        debug && console.debug(`[BR] Category page event supply functions have thrown an error:`, '\\n', e);\n      }\n    } else if (event.event === 'purchase') {\n      try {\n        const ev = event.ecommerce\n        br_data.ptype = 'other';\n        br_data.is_conversion = 1;\n        br_data.basket_value = ev.value ?? '';\n        br_data.currency = 'USD';\n        br_data.order_id = ev.transaction_id ?? '';\n\n        let basket = [];\n\n        try {\n          //Format basket\n\n          basket = ev.items.map((item) => {\n            return {\n              prod_id: item.item_id?.slice(0, -4) ?? '',\n              sku: item.full_sku?.replaceAll(/[^a-zA-Z0-9]/g, '_'),\n              name: item.item_name,\n              quantity: item.quantity ?? '1',\n              price: item.price ?? '',\n            };\n          }\n          );\n\n        } catch (e) {\n          basket = [];\n        }\n        br_data.basket = {\n          items: basket,\n        };\n        return true;\n      } catch (e) {\n        debug && console.debug(`[BR] Category page event supply functions have thrown an error:`, '\\n', e);\n      }\n    }\n\n    return false;\n  }\n\n\n  function injectBrTrk() {\n    try {\n      if (!debug) {\n        let selector = 'script[src=\"' + `//cdn.brcdn.com/v1/br-trk-${br_data.acct_id}.js\"`;\n        let present = document.querySelector(selector);\n        if (present)\n          return;\n      }\n      var brtrk = document.createElement('script');\n      brtrk.type = 'text/javascript';\n      brtrk.async = true;\n      brtrk.src = `//cdn.brcdn.com/v1/br-trk-${br_data.acct_id}.js`;\n      var s = document.getElementsByTagName('script')[0];\n      s.parentNode.insertBefore(brtrk, s);\n    } catch (e) {\n      debug && console.debug(`[BR] Error injecting the BrTrk script:`, '\\n', `src: \"${brtrk.src}\"`);\n    }\n  }\n}\n)();\n"
