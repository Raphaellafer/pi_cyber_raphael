{
  "manifest_version": 2,
  "name": "Análise de Raphael",
  "version": "0.3.0",
  "description": "Observa terceiros, cookies, storage HTML5, fingerprint e hijacking por aba, com score de privacidade e lista de bloqueio.",
  "permissions": ["webRequest", "webRequestBlocking", "cookies", "tabs", "storage", "webNavigation", "<all_urls>"],
  "background": {
    "scripts": ["lib/domains.js", "background.js"]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "browser_action": {
    "default_title": "Análise de Raphael",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "icons": {"48": "icons/icon-48.png"},
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
